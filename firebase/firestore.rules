rules_version = '2';

// GetHired CV Prompt Builder: each signed-in user can only read and write their own data.
// Paste into Firebase console > Firestore > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/data/{key} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && key in ['gethired_profile_v1', 'cv_content_bank', 'cl_prompt', 'cv_prompt', 'gethired_jd',
                   'gethired_export_draft', 'gethired_export_style', 'gethired_signature',
                   'gethired_polish_snapshot', 'gethired_sample_sections', 'gethired_headshot',
                   'gethired_applications']
        && request.resource.data.keys().hasOnly(['value', 'updatedAt'])
        && request.resource.data.value is string
        && request.resource.data.value.size() <= 900000
        && request.resource.data.updatedAt == request.time;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
